{
  "name": "taro",
  "version": "1.0.0",
  "private": true,
  "description": "Taro React TypeScript 项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "build:harmony": "taro build --type harmony_cpp",
    "dev:weapp": "pnpm run build:weapp --watch",
    "dev:swan": "pnpm run build:swan --watch",
    "dev:alipay": "pnpm run build:alipay --watch",
    "dev:tt": "pnpm run build:tt --watch",
    "dev:h5": "pnpm run build:h5 --watch",
    "dev:rn": "pnpm run build:rn --watch",
    "dev:qq": "pnpm run build:qq --watch",
    "dev:jd": "pnpm run build:jd --watch",
    "dev:harmony-hybrid": "pnpm run build:harmony-hybrid --watch",
    "dev:harmony": "pnpm run build:harmony --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src config --ext .ts,.tsx",
    "build:rn:ios": "mkdir -p ../../dist/ios/bundle && NODE_ENV=production TARO_ENV=rn react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ../../dist/ios/bundle/main.jsbundle --assets-dest ../../dist/ios/bundle",
    "dev:rn:ios": "NODE_ENV=development TARO_ENV=rn react-native start",
    "build:rn:android": "mkdir -p ../../dist/rn/android && NODE_ENV=production TARO_ENV=rn react-native bundle --platform android --dev false --entry-file index.js --bundle-output ../../dist/rn/android/index.android.bundle --assets-dest ../../dist/rn/android",
    "dev:rn:android": "NODE_ENV=development TARO_ENV=rn react-native start"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "author": "",
